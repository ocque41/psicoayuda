{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayudamental-venezuela",
  "main": "custom-worker.ts",
  "workers_dev": false,
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "saludmental-venezuela.com", "custom_domain": true },
    { "pattern": "www.saludmental-venezuela.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Caché persistente de OpenNext/Next (open-next.config.ts). El namespace KV y
  // el binding D1 para tags son infraestructura de rendimiento: sin ellos la
  // caché cae a "dummy" y cada visita re-renderiza la página entera.
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "044a3391fbd24974a9c4cfae7e3d8f02"
    }
  ],
  // Binding de servicio al propio Worker: la revalidación de ISR y el cache
  // interception lo usan para refrescar entradas sin salir a la red pública.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ayudamental-venezuela"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://saludmental-venezuela.com",
    "NEXT_PUBLIC_SITE_URL": "https://saludmental-venezuela.com",
    "GOOGLE_SITE_VERIFICATION": "",
    "ADMIN_EMAILS": "ocquema@gmail.com,martinezra02@gmail.com",
    "PUBLIC_CONTACT_EMAILS": "ocquema@gmail.com,martinezra02@gmail.com",
    "PRIVACY_CONTACT_EMAIL": "ocquema@gmail.com",
    "ABUSE_CONTACT_EMAIL": "ocquema@gmail.com",
    "NIDO_DB_TARGET": "cloudflare",
    // Remitente verificado en Resend (dominio saludmental-venezuela.com). No es
    // secreto; la API key sí va como secret: `wrangler secret put RESEND_API_KEY`.
    "CONTACT_FROM_EMAIL": "Nido <avisos@saludmental-venezuela.com>",
    // Token del beacon de Cloudflare Web Analytics (cuenta visitas, sin cookies).
    // Se copia del panel: Cloudflare → Analytics & Logs → Web Analytics → añadir
    // sitio saludmental-venezuela.com → token del snippet. No es secreto (va en el
    // HTML). Vacío = analítica de visitas desactivada; el resto funciona igual.
    "CF_BEACON_TOKEN": "",
    // Site key PÚBLICO del widget de Cloudflare Turnstile que protege los
    // formularios de credenciales del panel (correo/contraseña/teléfonos). El
    // secreto correspondiente vive como secreto del Worker:
    // `wrangler secret put TURNSTILE_SECRET_KEY`. Si falta cualquiera de los
    // dos, el panel funciona sin CAPTCHA (útil en desarrollo).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEytSBhHzeNfCMBZ",
    // Comisión FIJA de Nido por cada pago, en céntimos (500 = 5 €). Var pública;
    // las claves de Stripe van como secretos del Worker:
    // `wrangler secret put STRIPE_SECRET_KEY` y `STRIPE_WEBHOOK_SECRET`.
    "NIDO_PLATFORM_FEE_CENTS": "500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nido-venezuela-db",
      "database_id": "b91d3879-2106-4f34-a49c-f8377adb149e",
      "migrations_dir": "drizzle"
    },
    // Misma base, segundo binding: tabla `revalidations` del tag cache de
    // OpenNext (revalidación on-demand). La crea la migración 0025.
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "nido-venezuela-db",
      "database_id": "b91d3879-2106-4f34-a49c-f8377adb149e"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Conversation", "class_name": "Conversation" },
      // Cola de revalidación ISR (open-next.config.ts `queue`).
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conversation"] },
    { "tag": "v2", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "triggers": {
    // Retención diaria (03:00 UTC) + informe de clics cada 12h (00:00 y 12:00
    // UTC). El `scheduled()` de custom-worker.ts enruta según el cron que dispara.
    "crons": ["0 3 * * *", "0 */12 * * *"]
  }
}
