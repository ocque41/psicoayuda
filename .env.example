BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Secreto del RPC interno DO->Next (notificaciones de chat) y del cron de
# retención. Si está vacío cae a BETTER_AUTH_SECRET. En producción conviene uno
# dedicado: `wrangler secret put INTERNAL_NOTIFY_SECRET`.
INTERNAL_NOTIFY_SECRET=
# URL canónica pública del sitio (sin barra final). Se usa para metadatos SEO,
# sitemap.xml, robots.txt, canonical y datos estructurados.
# OJO: `NEXT_PUBLIC_*` se inyecta en BUILD TIME. El build de Cloudflare no lee
# esta variable, así que el valor real de producción vive como fallback en
# `src/lib/site.ts` (= el dominio propio). Solo define esto si construyes con
# otro dominio (p. ej. un preview).
NEXT_PUBLIC_SITE_URL=https://saludmental-venezuela.com
# Token de verificación de Google Search Console (método "etiqueta HTML").
# Pega solo el valor del atributo content. Vacío = no se emite la meta.
GOOGLE_SITE_VERIFICATION=
# Token del beacon de Cloudflare Web Analytics (cuenta visitas, sin cookies).
# Cloudflare → Analytics & Logs → Web Analytics → añadir saludmental-venezuela.com
# → copia el token del snippet. No es secreto (va en el HTML). Vacío = desactivado.
CF_BEACON_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=
# Admisión de psicólogos y fases; no concede administración general ni acceso a pacientes ajenos.
ADMISSION_REVIEWER_EMAILS=
# Correos visibles en /contacto y en el panel profesional. Esta lista no da
# acceso a /admin; la autorización sigue dependiendo solo de ADMIN_EMAILS.
PUBLIC_CONTACT_EMAILS=
# Destinatarios del aviso cuando un usuario llega a la página de error por un
# bug (lista separada por comas). Si está vacío, cae a ADMIN_EMAILS.
ERROR_ALERT_EMAILS=ocquema@gmail.com,martinezra02@gmail.com
# Automatización de errores → GitHub. Si defines un token (fine-grained PAT con
# permiso Issues: Read and write en el repo), cada error abre un issue con label
# `error-auto` para que un agente lo diagnostique y proponga un PR. SIN PII (el
# repo es público: no se sube el correo del usuario ni el query string). Vacío =
# desactivado. En producción: `wrangler secret put GITHUB_ISSUE_TOKEN`.
GITHUB_ISSUE_TOKEN=
GITHUB_ISSUE_REPO=ocque41/psicoayuda
DATABASE_URL=file:./local.db
ABUSE_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
NIDO_DB_TARGET=

# Optional Cloudflare D1 deployment notes/config values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Optional notifications. Email is sent from the Cloudflare Worker via Resend
# (https://resend.com). If RESEND_API_KEY or CONTACT_FROM_EMAIL are empty, email
# is silently skipped. CONTACT_FROM_EMAIL must be a verified Resend sender, e.g.
# "Nido <avisos@tudominio.com>". The professional gets notified at their
# registration email when someone writes to them.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
NOTIFICATION_EMAIL=

# Cloudflare Turnstile (anti-abuso en los formularios de credenciales del
# panel). El site key es público (va en el HTML); el secreto se configura como
# secreto de Cloudflare: `wrangler secret put TURNSTILE_SECRET_KEY`. Turnstile
# solo se exige cuando AMBOS están presentes; si falta uno, el panel funciona
# sin CAPTCHA (útil en desarrollo). Consigue las claves en el panel de
# Cloudflare → Turnstile o crea el widget vía API.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe (cobros de Nido con Connect). Se activa solo con AMBAS claves como
# secretos del Worker:
#   wrangler secret put STRIPE_SECRET_KEY        (clave restringida de Stripe)
#   wrangler secret put STRIPE_WEBHOOK_SECRET    (secreto del endpoint del webhook)
# El endpoint es https://saludmental-venezuela.com/api/stripe/webhook y debe
# escuchar, como mínimo: checkout.session.completed, checkout.session.expired,
# payment_intent.payment_failed, charge.refunded, charge.dispute.created y
# account.updated. Si falta cualquiera de las dos claves, la sección de cobros
# del panel y las páginas /pagar se ocultan (la web funciona igual).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comisión de terapia: 0 por defecto; el modelo comercial cobra el software. Es una var
# pública del Worker (wrangler.jsonc), no un secreto.
NIDO_PLATFORM_FEE_CENTS=0

# CRM y cola según horario; activar tras aplicar 0027. El cron también purga
# los archivos de llamadas a los 30 días. Consultar docs/producto/05-operacion.md.
NIDO_PRACTICE_ENABLED=false
SUPPORT_EMAILS=
CREDENTIAL_REVIEWER_EMAILS=
# Facturación del software y cobros de pacientes tienen activación independiente.
NIDO_MEMBERSHIP_BILLING_ENABLED=false
NIDO_CARE_BILLING_ENABLED=false
# Países Connect adicionales SOLO tras confirmación expresa de Stripe.
NIDO_CONNECT_COUNTRIES=
# Secreto del proveedor; nunca NEXT_PUBLIC. Grabación desactivada de inicio.
DAILY_API_KEY=
NIDO_CALL_CAPTURE_ENABLED=false
NIDO_CALL_CAPTURE_POLICY_URL=
